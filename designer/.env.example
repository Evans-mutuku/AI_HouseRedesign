# Firebase web config, from the Firebase console:
#   Project settings → General → Your apps → Web app → SDK setup and configuration
#
# These are public values — they ship in the bundle and grant nothing on their
# own. Access is decided by the ID token the SDK mints, which the API verifies.
# Set the same project id as FIREBASE_PROJECT_ID in server/.env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
