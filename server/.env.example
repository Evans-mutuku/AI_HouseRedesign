# --- Anthropic ---
# Your key. Stays on the server. NEVER expose to the client or commit it.
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-4-6 (default, cheaper) or claude-opus-4-8 (higher design quality)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/housedesign
# Set to "require" for managed/cloud Postgres that needs SSL. Leave unset locally.
# PGSSL=require

# --- OpenAI (rendered "after" image) ---
# Powers gpt-image-1 via the images/edits endpoint. Server-only; never exposed
# to the client. Requires an OpenAI account with gpt-image-1 access.
OPENAI_API_KEY=sk-proj-...
OPENAI_IMAGE_MODEL=gpt-image-1
# Leave unset (or "auto") to match the output shape to the uploaded photo. A
# fixed value reframes portrait photos to landscape and crops whatever sat at
# the top and bottom — very often a tall window or a door head.
# OPENAI_IMAGE_SIZE=auto
# low | medium | high | auto  (higher = better + pricier)
OPENAI_IMAGE_QUALITY=high
# How faithfully the edit preserves the source photo. "high" is the strongest
# single lever against the render quietly redrawing your architecture.
OPENAI_INPUT_FIDELITY=high

# --- Firebase (accounts) ---
# The `projectId` from your Firebase web config. The server uses it to verify
# the ID tokens the browser sends, against Google's public signing keys — no
# service-account key file is needed. This value is public, not a secret.
FIREBASE_PROJECT_ID=your-project-id

# --- Media signing ---
# Signs the short-lived URLs that serve room photos and renders. This IS a
# secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable across restarts, or image links break mid-session.
MEDIA_SIGNING_SECRET=change-me

# --- Generation pipeline ---
# After each render, Claude compares it with the room survey and reports any
# window or door that went missing. This is how many times we re-render with a
# reinforced prompt when it finds one. 0 disables the retry (the check still
# runs and its result is still stored).
RENDER_FIDELITY_RETRIES=1
# How often the background worker looks for a queued job, in ms.
WORKER_POLL_MS=1500
# How often the janitor purges expired trash and sweeps orphaned files, in ms.
JANITOR_INTERVAL_MS=3600000

# --- Server ---
PORT=5000
# Max redesigns started per account per minute.
REDESIGN_RATE_LIMIT=10
